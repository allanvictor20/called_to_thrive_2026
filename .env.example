# Copy to .env for local development. Never commit real secrets.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://ctt:secret@localhost:5432/called_to_thrive
TEST_DATABASE_NAME=called_to_thrive_test

# Production only
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DJANGO_DEFAULT_FROM_EMAIL=Called to Thrive <no-reply@example.org>
# Shared cache so rate limits apply across workers:
# DJANGO_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
# DJANGO_CACHE_LOCATION=ctt_cache
